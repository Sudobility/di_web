{
  "name": "@sudobility/di_web",
  "version": "0.1.259",
  "description": "Web implementations of dependency injection services for Sudobility",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/sw/vite-plugin-service-worker.js",
      "types": "./dist/sw/vite-plugin-service-worker.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && cp src/sw/sw.js dist/sw/sw.js && cp src/sw/firebase-messaging-sw.js dist/sw/firebase-messaging-sw.js",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "prepublishOnly": "bun run clean && bun run test:unit && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,js}"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "keywords": [
    "dependency-injection",
    "di",
    "web",
    "web3"
  ],
  "author": "Sudobility Inc",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/components": "^5.3.41",
    "@sudobility/di": "^1.5.77",
    "@sudobility/types": "^1.9.76",
    "react": "^18.0.0 || ^19.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/di_web.git"
  },
  "peerDependenciesMeta": {
    "@sudobility/subscription_lib": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/components": "^5.3.41",
    "@sudobility/di": "^1.5.77",
    "@sudobility/subscription_lib": "^0.0.56",
    "@sudobility/types": "^1.9.76",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~3.2.7",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "jsdom": "~27.4.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
